# Duct backend configuration.
#
# Copy to `.env.local` for local dev. Every setting below has a default, which
# is the trap this file exists to cover: nothing fails loudly when a variable is
# missing — the feature it powers just quietly does nothing. So a var being
# absent here used to mean "undiscoverable", not "unused".
#
# `backend/tests/test_env_example.py` now keeps this honest: it fails when a
# credential-shaped setting in `config.py` is missing here, and when a key here
# no longer maps to a real setting.
#
# Source of truth for anything unclear is `config.py`. Values here are examples,
# never real credentials — every `.env*` file except this one is gitignored.


# ---------------------------------------------------------------------------
# Core — the backend will start without these, but little will work
# ---------------------------------------------------------------------------

# Postgres for the deployment; the desktop sidecar derives its own SQLite path
# and ignores this. Local dev usually points at the Railway proxy URL.
DATABASE_URL=

# Signs session JWTs. Must be long and random — config.py enforces a strength
# floor. Changing it invalidates every existing session.
DUCT_JWT_SECRET=

# Encrypts stored third-party OAuth credentials at rest. Rotating this without
# re-encrypting makes every stored connector credential undecryptable.
CREDENTIALS_ENCRYPTION_KEY=

# Shared `X-API-Key` between the app and this API. The desktop sidecar ignores
# it and generates a per-install key in its own data dir instead.
DUCT_API_KEY=

# Where this API is reachable, used to build OAuth redirect URIs.
API_PUBLIC_URL=http://localhost:8002
# Origin allowed by CORS and used for post-sign-in redirects.
FRONTEND_ORIGIN=http://localhost:3003
# local | staging | production | desktop. Gates dev-only affordances such as
# authenticating the Claude SDK with a local `claude` login.
APP_ENV=local


# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Users may supply their own per request (X-Provider-* headers); these are the
# server's fallbacks. A key left empty disables the engines that need it.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini. NOTE: the langchain-google-genai SDK separately reads GOOGLE_API_KEY
# straight from the environment, so local dev often needs both set.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# OpenRouter — one key, 400+ models, on its own LangChain integration
# (`langchain-openrouter`). v1 only: the Claude Agent SDK is provider-locked, so
# v3 asked for OpenRouter degrades to Anthropic rather than appearing to work.
OPENROUTER_API_KEY=
# Override OpenRouter's endpoint — a regional endpoint, or a self-hosted proxy
# that speaks OpenRouter's API. Empty means OpenRouter's own endpoint.
# NOT the way to reach a different gateway: this builds a ChatOpenRouter, which
# speaks OpenRouter's protocol rather than plain chat-completions, so aiming it
# at Ollama would talk the wrong protocol to it. A local model server or a
# self-hosted router needs a GATEWAY_BASE_URL entry in agents/models.py instead.
OPENROUTER_BASE_URL=

# xAI (Grok), on its own LangChain integration (`langchain-xai`). A first-party
# vendor, not a gateway, so it needs no base URL. v1 only, for the same reason
# as OpenRouter: the Claude Agent SDK is provider-locked.
XAI_API_KEY=

# Long-lived token from `claude setup-token`, letting the Claude Agent SDK run
# on a subscription instead of an API key. Operator's own use only — never for
# serving end users. See config.claude_oauth_available().
CLAUDE_CODE_OAUTH_TOKEN=


# ---------------------------------------------------------------------------
# Google OAuth sign-in
# ---------------------------------------------------------------------------
# Two clients in the same GCP project, not interchangeable:
#   WEB     - the hosted API's fixed https redirect (Railway, and local uvicorn)
#   DESKTOP - an installed-app client, required because the desktop sidecar
#             redirects to http://127.0.0.1:<os-picked port>
# The backend picks the desktop pair automatically when DUCT_LOCAL is set.
# The unprefixed GOOGLE_OAUTH_CLIENT_ID / _SECRET are still read as a fallback.
GOOGLE_WEB_OAUTH_CLIENT_ID=
GOOGLE_WEB_OAUTH_CLIENT_SECRET=
GOOGLE_DESKTOP_OAUTH_CLIENT_ID=
GOOGLE_DESKTOP_OAUTH_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Google Ads API
# ---------------------------------------------------------------------------
# Developer token: Google Ads → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # optional default (dashes OK)
# Optional: manager account when accessing client accounts
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Shared by all three processes: this backend, the desktop sidecar, and — baked
# in at build time via `option_env!` — the Tauri shell
# (desktop/src-tauri/src/telemetry.rs). One spelling everywhere on purpose.
# The desktop sidecar only ever receives it when the user opts in.
SENTRY_DSN=
# The sidecar binds 127.0.0.1, which server.py otherwise treats as "not
# deployed", dropping every event. Set for local/desktop runs, not for Railway.
SENTRY_ENABLE_LOCALHOST=
# Route the Claude Agent SDK's OpenTelemetry traces to Sentry.
SDK_OTEL_ENABLED=
# 1/true logs per-message SDK events and costs for audit runs.
AUDIT_VERBOSE_LOGGING=


# ---------------------------------------------------------------------------
# Third-party services
# ---------------------------------------------------------------------------

# Apify — TikTok discovery for the content agents.
APIFY_API_KEY=
# PostBridge — social publishing and post analytics.
POSTBRIDGE_API_KEY=
# Cloudflare Turnstile — bot check on the public lead form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# R2 object storage. Only the secret is listed here because it is the sensitive
# half; see config.py for the account/bucket/endpoint settings beside it.
R2_SECRET_ACCESS_KEY=


# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Transactional email (project invitations). Leave RESEND_API_KEY empty and
# invitations are logged instead of sent — fine for local dev. EMAIL_FROM must
# be on a domain verified in Resend to actually send.
RESEND_API_KEY=
EMAIL_FROM=noreply@getduct.ai
EMAIL_FROM_NAME=Duct
INVITATION_TTL_DAYS=7

# Lead audit report delivery (Cloudflare Email Service). Leave the token empty
# and report emails are skipped with a warning — fine for local dev.
# LEAD_EMAIL_FROM falls back to EMAIL_FROM when unset. LEAD_EMAIL_CC is the
# comma-separated internal list copied on lead reports and notified of new
# execution interest; empty means no CC header is sent.
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LEAD_EMAIL_FROM=
LEAD_EMAIL_CC=


# ---------------------------------------------------------------------------
# API docs
# ---------------------------------------------------------------------------
# /docs and /openapi.json are off unless enabled, and behind basic auth when on.
EXPOSE_OPENAPI_DOCS=
DUCT_OPENAPI_DOCS_BASIC_USER=
DUCT_OPENAPI_DOCS_BASIC_PASSWORD=


# ---------------------------------------------------------------------------
# Not read by config.py
# ---------------------------------------------------------------------------
# PORT is supplied by Railway and consumed by the uvicorn start command in
# railway.json, never by Configs. Local dev passes --port explicitly instead.

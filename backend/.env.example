# Google Ads API
# Developer token: Google Ads → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=   # optional default (dashes OK)

# Gemini (aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Server
PORT=8000

# Transactional email (project invitations).
# Leave RESEND_API_KEY empty and invitations are logged instead of sent — fine
# for local dev. EMAIL_FROM must be on a domain verified in Resend to send.
RESEND_API_KEY=
EMAIL_FROM=noreply@getduct.ai
EMAIL_FROM_NAME=Duct
INVITATION_TTL_DAYS=7

# Optional: manager account when accessing client accounts
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Lead audit report delivery (Cloudflare Email Service). Leave the token empty
# and report emails are skipped with a warning — fine for local dev.
# LEAD_EMAIL_FROM falls back to EMAIL_FROM when unset. LEAD_EMAIL_CC is the
# comma-separated internal list copied on lead reports and notified of new
# execution interest; empty means no CC header is sent.
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LEAD_EMAIL_FROM=
LEAD_EMAIL_CC=

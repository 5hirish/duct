{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["**/*.py", "pyproject.toml", "poetry.lock"]
  },
  "deploy": {
    "startCommand": "poetry run uvicorn server:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}

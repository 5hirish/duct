{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "description": "Duct minimal report viewer app shell.",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' next dev -p 3003",
    "check:parity": "node scripts/check-slide-parity.mjs && node scripts/check-connector-count.mjs && node scripts/check-data-sources.mjs && node scripts/check-desk.mjs && node scripts/check-type-scale.mjs",
    "check:type": "node scripts/check-type-scale.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:agents": "node scripts/mock-agent-backend.mjs",
    "start": "next start",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:connectors": "node scripts/check-connector-count.mjs",
    "check:desk": "node scripts/check-desk.mjs",
    "check:sources": "node scripts/check-data-sources.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@sentry/nextjs": "^10.73.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "lucide-react": "^1.39.0",
    "mermaid": "^11.17.2",
    "modern-screenshot": "^4.7.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.128.0"
  }
}

{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "description": "Duct minimal report viewer app shell.",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' next dev -p 3003",
    "check:parity": "node scripts/check-slide-parity.mjs && node scripts/check-connector-count.mjs && node scripts/check-data-sources.mjs && node scripts/check-desk.mjs && node scripts/check-type-scale.mjs && node scripts/check-design-system.mjs && node scripts/check-contrast.mjs && node scripts/check-backend-gate.mjs",
    "check:gate": "node scripts/check-backend-gate.mjs",
    "check:type": "node scripts/check-type-scale.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design-system.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mock:agents": "node scripts/mock-agent-backend.mjs",
    "start": "next start",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:connectors": "node scripts/check-connector-count.mjs",
    "check:desk": "node scripts/check-desk.mjs",
    "check:sources": "node scripts/check-data-sources.mjs",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "prebuild": "lingui compile --strict",
    "predev": "lingui compile",
    "check:i18n": "lingui extract && [ -z \"$(git status --porcelain -- src/locales)\" ] || (echo \"catalogues are stale or uncommitted: run npm run i18n:extract and commit src/locales\" && exit 1); lingui compile --strict && node scripts/check-literal-strings.mjs"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@lingui/core": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@sentry/nextjs": "^10.74.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.45.0",
    "mermaid": "^12.0.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@lingui/cli": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@lingui/swc-plugin": "6.6.0",
    "@opennextjs/cloudflare": "^1.20.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.134.0"
  }
}

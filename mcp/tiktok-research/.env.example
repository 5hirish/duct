# Apify API token — required. Create one at https://console.apify.com/account/integrations
APIFY_API_KEY=

# --- optional tuning ---
# Default resultsPerPage for keyword/hashtag searches (each result costs Apify credits).
# TIKTOK_MCP_DEFAULT_RESULTS=20
# Max seconds a search tool waits for the Apify run to finish before returning a run_id to poll.
# TIKTOK_MCP_MAX_WAIT_S=120
# Where fetch_tiktok_media(kind="video") saves .mp4 files (default: OS temp dir).
# TIKTOK_MCP_MEDIA_DIR=

msgstr "<0/><1/><2>Stripe + GA4</2>"

#: integrations/stripe.html
msgid ""
"<0><1/><2></2><3/></0><4>Does Meta's purchase count survive Stripe?</4><5>Stripe + Meta Ads <6/></5>"
msgstr ""
"<0><1/><2></2><3/></0><4>Meta 的购买计数在 Stripe 之后仍然有效吗？</4><5>Stripe + Meta Ads <6/></5>"

#: integrations/stripe.html
msgid ""
"<0><1/><2></2><3/></0><4>Web and app revenue, read as one number.</4><5>Stripe + RevenueCat <6/></5>"
msgstr "<0><1/><2></2><3/></0><4>网页和应用收入，读取为一个数字。</4><5>Stripe + RevenueCat <6/></5>"

#: integrations/stripe.html
msgid ""
"<0><1/><2></2><3/></0><4>Which Google campaigns bring customers who pay?</4><5>Stripe + Google Ads <6/></5>"
msgstr ""
"<0><1/><2></2><3/></0><4>哪些 Google 广告系列带来了付费客户？</4><5>Stripe + Google Ads <6/></5>"

#: integrations/stripe.html
msgid ""
"<0>new paid subscriptions</0><1>never-paid checkouts</1><2>gross</2><3>refunded</3><4>net</4><5>new MRR</5>"
msgstr "<0>新增付费订阅</0><1>未付费结账</1><2>总额</2><3>已退款</3><4>净额</4><5>新增 MRR</5>"


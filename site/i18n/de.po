msgstr ""
"<0><1/><2></2><3/></0><4>Ist es die Anzeige oder die Seite danach?</4><5>Clarity + Google Ads <6/></5>"

#: integrations/microsoft-clarity.html
msgid ""
"<0><1/><2></2><3/></0><4>Where in the funnel do people get stuck?</4><5>Clarity + Mixpanel <6/></5>"
msgstr ""
"<0><1/><2></2><3/></0><4>Wo im Funnel bleiben die Leute stecken?</4><5>Clarity + Mixpanel <6/></5>"

#: integrations/microsoft-clarity.html
msgid ""
"<0><1/><2></2><3/></0><4>Which friction costs conversions?</4><5>Clarity + GA4 <6/></5>"
msgstr ""
"<0><1/><2></2><3/></0><4>Welche Reibung kostet Conversions?</4><5>Clarity + GA4 <6/></5>"

#: integrations/microsoft-clarity.html
msgid ""

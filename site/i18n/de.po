msgid "Connect Mixpanel <0>in three steps</0>"
msgstr "Mixpanel <0>in drei Schritten</0> verbinden"

#: integrations/mixpanel.html
msgid "Did the release move upgrades, or only the test accounts?"
msgstr "Hat das Release Upgrades verschoben oder nur die Testkonten?"


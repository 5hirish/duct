msgid "Google Analytics 4 admin settings"
msgstr "Configurações de administrador do Google Analytics 4"

#: privacy.html
msgid "Google Analytics 4 reporting data and property configuration"
msgstr "Dados de relatórios e configuração de propriedade do Google Analytics 4"

#: privacy.html
msgid "Google Search Console queries, pages, impressions, clicks and positions"
msgstr "Consultas, páginas, impressões, cliques e posições do Google Search Console"

#: privacy.html
msgid "Google Tag Manager (Conversion Linker)"
msgstr "Google Tag Manager (Vinculador de Conversões)"

#: privacy.html
msgid "Google Tag Manager accounts, containers, tags and triggers"
msgstr "Contas, contêineres, tags e acionadores do Google Tag Manager"

#: privacy.html

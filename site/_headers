  Link: </blog/>; rel="alternate"; type="text/html"; title="Blog"
  Link: <https://getduct.ai/sitemap.xml>; rel="sitemap"
  Link: <https://getduct.ai/blog/feed.xml>; rel="alternate"; type="application/rss+xml"; title="Duct Blog"
  Link: <https://getduct.ai/changelog/feed.xml>; rel="alternate"; type="application/rss+xml"; title="Duct Changelog"

# Cloudflare serves .xml as application/xml; readers want the RSS type.
/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/changelog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Cloudflare Pages revalidates every asset on every view by default. The
# shots, art, cards and icons change only with a deliberate reshoot, so a
# repeat visitor can keep them for a week instead of asking each time.
/assets/media/*
  Cache-Control: public, max-age=604800
/assets/art/*
  Cache-Control: public, max-age=604800
/assets/og/*
  Cache-Control: public, max-age=604800
/assets/icons/*
  Cache-Control: public, max-age=604800

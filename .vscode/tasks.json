{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve site on :8080",
      "type": "shell",
      "command": "python3 -m http.server 8080",
      "options": { "cwd": "${workspaceFolder}/site" },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "site",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP on"
        }
      }
    }
  ]
}

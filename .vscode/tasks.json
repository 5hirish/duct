{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: uvicorn",
      "type": "shell",
      "command": "poetry run uvicorn server:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "duct-stack",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running"
        }
      }
    },
    {
      "label": "Serve site on :8080",
      "type": "shell",
      "command": "python3 dev_server.py --port 8080",
      "options": { "cwd": "${workspaceFolder}/site" },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "site",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving Cloudflare-style site routes on"
        }
      }
    },
    {
      "label": "Backend: stop ADK web (8001)",
      "type": "shell",
      "command": "if command -v lsof >/dev/null 2>&1; then pids=$(lsof -t -i :8001 2>/dev/null || true); if [ -n \"$pids\" ]; then kill -9 $pids >/dev/null 2>&1 || true; fi; fi",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: stop uvicorn (8000)",
      "type": "shell",
      "command": "if command -v lsof >/dev/null 2>&1; then pids=$(lsof -t -i :8000 2>/dev/null || true); if [ -n \"$pids\" ]; then kill -9 $pids >/dev/null 2>&1 || true; fi; fi; pkill -f \"uvicorn server:app\" >/dev/null 2>&1 || true",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Site: stop dev server (8080)",
      "type": "shell",
      "command": "if command -v lsof >/dev/null 2>&1; then pids=$(lsof -t -i :8080 2>/dev/null || true); if [ -n \"$pids\" ]; then kill -9 $pids >/dev/null 2>&1 || true; fi; fi; pkill -f \"dev_server.py\" >/dev/null 2>&1 || true",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Site: Playwright smoke tests",
      "type": "shell",
      "command": "npm run test:e2e",
      "options": { "cwd": "${workspaceFolder}/site" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "site-qa",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}

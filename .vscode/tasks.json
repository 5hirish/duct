{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve site on :8080",
      "type": "shell",
      "command": "python3 -m http.server 8080",
      "options": { "cwd": "${workspaceFolder}/site" },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "site",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP on"
        }
      }
    },
    {
      "label": "Open Google Ads report in Chrome (demo)",
      "type": "shell",
      "command": "open",
      "args": [
        "-a",
        "Google Chrome",
        "${workspaceFolder}/backend/reports/google-ads-report.html"
      ],
      "presentation": { "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    },
    {
      "label": "Open Google Ads report in Chrome (client brief)",
      "type": "shell",
      "command": "open",
      "args": [
        "-a",
        "Google Chrome",
        "${workspaceFolder}/backend/reports/client-brief.html"
      ],
      "presentation": { "reveal": "silent", "panel": "shared", "showReuseMessage": false },
      "problemMatcher": []
    }
  ]
}

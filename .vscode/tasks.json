{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Phoenix: start (OTEL traces UI)",
      "type": "shell",
      "command": "poetry run python -m phoenix.server.main serve",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "duct-observability",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "phoenix",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Phoenix UI"
        }
      }
    },
    {
      "label": "Backend: uvicorn (verbose)",
      "type": "shell",
      "command": "AUDIT_VERBOSE_LOGGING=1 poetry run uvicorn server:app --host 127.0.0.1 --port 8002",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "duct-stack",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running"
        }
      }
    },
    {
      "label": "Backend: uvicorn",
      "type": "shell",
      "command": "poetry run uvicorn server:app --reload --reload-dir \"${workspaceFolder}/backend\" --reload-exclude \"${workspaceFolder}/backend/.venv\" --reload-exclude \"${workspaceFolder}/backend/data\" --reload-exclude \"${workspaceFolder}/backend/alembic\" --reload-exclude \"${workspaceFolder}/backend/tests\" --reload-delay 1 --host 127.0.0.1 --port 8002",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "duct-stack",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "uvicorn",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running"
        }
      }
    },
    {
      "label": "Serve site on :8090",
      "type": "shell",
      "command": "python3 dev_server.py --port 8090",
      "options": { "cwd": "${workspaceFolder}/site" },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "site",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving Cloudflare-style site routes on"
        }
      }
    },
    {
      "label": "Backend: stop ADK web (8003)",
      "type": "shell",
      "command": "if command -v lsof >/dev/null 2>&1; then pids=$(lsof -t -i :8003 2>/dev/null || true); if [ -n \"$pids\" ]; then kill -9 $pids >/dev/null 2>&1 || true; fi; fi",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: stop uvicorn (8002)",
      "type": "shell",
      "command": "if command -v lsof >/dev/null 2>&1; then pids=$(lsof -t -i :8002 2>/dev/null || true); if [ -n \"$pids\" ]; then kill -9 $pids >/dev/null 2>&1 || true; fi; fi; pkill -f \"uvicorn server:app\" >/dev/null 2>&1 || true",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Duct: stop Site + API (8002, 8090)",
      "dependsOn": [
        "Backend: stop uvicorn (8002)",
        "Site: stop dev server (8090)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Site: stop dev server (8090)",
      "type": "shell",
      "command": "if command -v lsof >/dev/null 2>&1; then pids=$(lsof -t -i :8090 2>/dev/null || true); if [ -n \"$pids\" ]; then kill -9 $pids >/dev/null 2>&1 || true; fi; fi; pkill -f \"dev_server.py\" >/dev/null 2>&1 || true",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Site: Playwright smoke tests",
      "type": "shell",
      "command": "npm run test:e2e",
      "options": { "cwd": "${workspaceFolder}/site" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "site-qa",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}

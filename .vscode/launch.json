{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Home page",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Open Product Intelligence page",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/for-product-intelligence.html"
    },
    {
      "name": "Open Organic Growth page",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/for-organic-growth.html"
    },
    {
      "name": "Start HTTP server",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 -m http.server 8080",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Open Blog (via HTTP server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/blog/index.html"
    }
  ],
  "compounds": [
    {
      "name": "Serve + Open Blog",
      "configurations": ["Start HTTP server", "Open Blog (via HTTP server)"],
      "stopAll": true
    }
  ]
}

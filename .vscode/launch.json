{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Duct: App + API + Phoenix (verbose)",
      "configurations": [
        "Backend: FastAPI (uvicorn verbose)",
        "App: dev server",
        "Phoenix: OTEL traces UI (:6006)"
      ],
      "stopAll": true
    },
    {
      "name": "Duct: App + API",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "App: dev server"
      ],
      "stopAll": true,
      "postDebugTask": "Backend: stop uvicorn (8002)"
    },
    {
      "name": "Duct: Desktop + API",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "App: dev server",
        "Desktop: Duct Dev app (build + open)"
      ],
      "stopAll": true,
      "postDebugTask": "Backend: stop uvicorn (8002)"
    },
    {
      "name": "Duct: Desktop (tauri dev — no sign-in) + API",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "Desktop: Tauri dev (local app)"
      ],
      "stopAll": true,
      "postDebugTask": "Backend: stop uvicorn (8002)"
    },
    {
      "name": "Duct: Site + API",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "Site: dev server"
      ],
      "stopAll": true,
      "postDebugTask": "Duct: stop Site + API (8002, 8090)"
    },
    {
      "name": "Duct: Site + App + API",
      "configurations": [
        "Backend: FastAPI (uvicorn)",
        "App: dev server",
        "Site: dev server"
      ],
      "stopAll": true,
      "postDebugTask": "Duct: stop Site + API (8002, 8090)"
    }
  ],
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "node-terminal",
      "request": "launch",
      "command": "poetry run uvicorn server:app --reload --reload-dir \"${workspaceFolder}/backend\" --reload-exclude \"${workspaceFolder}/backend/.venv\" --reload-exclude \"${workspaceFolder}/backend/data\" --reload-exclude \"${workspaceFolder}/backend/alembic\" --reload-exclude \"${workspaceFolder}/backend/tests\" --reload-delay 1 --timeout-graceful-shutdown 10 --host 127.0.0.1 --port 8002",
      "cwd": "${workspaceFolder}/backend",
      "env": { "NODE_OPTIONS": "" }
    },
    {
      "name": "Backend: FastAPI (uvicorn verbose)",
      "type": "node-terminal",
      "request": "launch",
      "command": "AUDIT_VERBOSE_LOGGING=1 poetry run uvicorn server:app --timeout-graceful-shutdown 10 --host 127.0.0.1 --port 8002",
      "cwd": "${workspaceFolder}/backend",
      "env": { "NODE_OPTIONS": "" }
    },
    {
      "name": "Phoenix: OTEL traces UI (:6006)",
      "type": "node-terminal",
      "request": "launch",
      "command": "poetry run python -m phoenix.server.main serve",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Backend: ADK web",
      "type": "node-terminal",
      "request": "launch",
      "command": "poetry run adk web --host 127.0.0.1 --port 8003 agents",
      "cwd": "${workspaceFolder}/backend",
      "postDebugTask": "Backend: stop ADK web (8003)"
    },
    {
      "name": "App: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/app"
    },
    {
      "name": "Desktop: Tauri dev (local app)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:local",
      "cwd": "${workspaceFolder}/desktop"
    },
    {
      "//": "Builds the dev-variant bundle (own identifier + ai.getduct.desktop.dev scheme, so it coexists with TestFlight), waits for the Next dev server, then opens it. Unlike `tauri dev` this is a registered .app, so the sign-in deep link works. Rebuild is incremental (~15s); web changes still hot-reload.",
      "name": "Desktop: Duct Dev app (build + open)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build:dev && until curl -sf http://localhost:3003 >/dev/null 2>&1; do sleep 1; done && open 'src-tauri/target/debug/bundle/macos/Duct Dev.app'",
      "cwd": "${workspaceFolder}/desktop"
    },
    {
      "name": "Site: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 dev_server.py --port 8090",
      "cwd": "${workspaceFolder}/site",
      "postDebugTask": "Site: stop dev server (8090)"
    },
    {
      "name": "Site: Playwright smoke tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:e2e",
      "cwd": "${workspaceFolder}/site"
    },
    {
      "name": "Backend: Pytest (all)", 
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Duct: App + API (API first)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/app",
      "preLaunchTask": "Backend: uvicorn",
      "postDebugTask": "Backend: stop uvicorn (8000)"
    },
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "node-terminal",
      "request": "launch",
      "command": "poetry run uvicorn server:app --reload --host 127.0.0.1 --port 8000",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "App: dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/app"
    },
    {
      "name": "Open Home page",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/site/index.html"
    },
    {
      "name": "Open Blog page",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/blog/index.html",
      "preLaunchTask": "Serve site on :8080"
    },
    {
      "name": "Site: Playwright smoke tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:e2e",
      "cwd": "${workspaceFolder}/site"
    },
    {
      "name": "Backend: Pytest (all)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "python": "${workspaceFolder}/backend/.venv/bin/python"
    }
  ]
}

# Environment and local secrets
.env
.env.*
**/.env
**/.env.*
!**/.env.example
client_secret_*.json
# A GitHub App's private key, as GitHub names the download
# (<slug>.<date>.private-key.pem). It mints a token for every installation of
# the App, so it goes in GITHUB_APP_PRIVATE_KEY and never into this public tree.
*.private-key.pem

backend/tests/outputs/

.vscode/chrome-site-debug/

# Claude Code session file references (dragged-in media)
.file-refs/
# scripts/shots leaves a raw capture beside a scenario that failed
docs/assets/readme/*.failed.png

# Worktrees live inside the repo, never beside it (root AGENTS.md, "git hygiene")
.worktrees/

# Eval gate output (scripts/agent_eval.py) and live-eval scorecards: a run's
# record, uploaded as a CI artifact, never a baseline. Baselines are
# backend/tests/eval/baselines.json, changed only by a ratchet PR.
eval-results.jsonl
audit-eval-scorecard.json
scorecard-*.json

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duct Dev",
  "identifier": "ai.getduct.desktop.dev",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ai.getduct.desktop.dev"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["default", "dev-localhost"]
    },
    "windows": [
      {
        "label": "main",
        "title": "Duct (dev build)",
        "url": "http://localhost:3003",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duct",
  "version": "0.3.0",
  "identifier": "ai.getduct.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ai.getduct.desktop"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRDE4MUREOEJCMUQ3MTEKUldRUjE3R0wzWUhSa0VUejE3OHFJTVhOMmJna25BdUtsbi9TOTF2R0VraU54dkJLS2RzbXAwMDkK",
      "endpoints": [
        "https://github.com/5hirish/duct/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Duct",
        "url": "https://app.getduct.ai",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/duct-sidecar": "duct-sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.developerid.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
